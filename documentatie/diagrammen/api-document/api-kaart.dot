digraph API {
graph [fontname="Helvetica", rankdir=TB, nodesep=0.35, ranksep=0.5, pad=0.3, labelloc=t, label=<<B>Alle endpoints onder /api</B>>, fontsize=16]
node [shape=none, fontname="Helvetica", fontcolor="#111827"]
edge [style=invis]
"Authenticatie" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="#FFFFFF"><B>Authenticatie</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>POST</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/authentication/forgot-password</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>POST</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/authentication/login</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>POST</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/authentication/register</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>POST</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/authentication/reset-password</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>POST</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/authentication/verify</FONT></TD></TR></TABLE>>];
"Metingen" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="#FFFFFF"><B>Metingen</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/measurement/history</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/measurement/history/average/region/{regionId}</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/measurement/history/average/{id}</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/measurement/history/half-hourly/{id}</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/measurement/history/hourly/{id}</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/measurement/history/network</FONT></TD></TR><TR><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11">/measurement/coverage</FONT></TD></TR></TABLE>>];
"Meetstations" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="#FFFFFF"><B>Meetstations</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/meetstation/availability/{stationId}/{workshopCode}</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/meetstation/measurements/{id}</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/meetstation/stations</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/meetstation/stations-met-measurements</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/meetstation/{id}</FONT></TD></TR><TR><TD BGCOLOR="#FECB3D" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>PUT</B></FONT></TD><TD BGCOLOR="#FECB3D" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/meetstation/claim</FONT></TD></TR><TR><TD BGCOLOR="#FECB3D" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>PUT</B></FONT></TD><TD BGCOLOR="#FECB3D" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/meetstation/edit/{id}</FONT></TD></TR><TR><TD BGCOLOR="#FECB3D" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>PUT</B></FONT></TD><TD BGCOLOR="#FECB3D" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/meetstation/transfer/{id}</FONT></TD></TR><TR><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>POST</B></FONT></TD><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11">/meetstation/add</FONT></TD></TR></TABLE>>];
"Mijn account" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="#FFFFFF"><B>Mijn account</B></FONT></TD></TR><TR><TD BGCOLOR="#FECB3D" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FECB3D" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/my-account</FONT></TD></TR><TR><TD BGCOLOR="#FECB3D" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>PUT</B></FONT></TD><TD BGCOLOR="#FECB3D" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/my-account</FONT></TD></TR></TABLE>>];
