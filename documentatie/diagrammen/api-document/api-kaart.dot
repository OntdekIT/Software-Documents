"Snapshot" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="#FFFFFF"><B>Snapshot</B></FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/snapshot</FONT></TD></TR><TR><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#FFF9E6" ALIGN="LEFT"><FONT COLOR="#111827" POINT-SIZE="11">/status</FONT></TD></TR></TABLE>>];
"Gebruikers" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="#FFFFFF"><B>Gebruikers</B></FONT></TD></TR><TR><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11">/users</FONT></TD></TR><TR><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>DELETE</B></FONT></TD><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11">/users/{id}</FONT></TD></TR><TR><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11">/users/{id}</FONT></TD></TR><TR><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>PUT</B></FONT></TD><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11">/users/{id}</FONT></TD></TR></TABLE>>];
"Workshops" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="#FFFFFF"><B>Workshops</B></FONT></TD></TR><TR><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11">/workshops</FONT></TD></TR><TR><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>POST</B></FONT></TD><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11">/workshops</FONT></TD></TR><TR><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>DELETE</B></FONT></TD><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11">/workshops/{code}</FONT></TD></TR><TR><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>GET</B></FONT></TD><TD BGCOLOR="#8A6408" ALIGN="LEFT"><FONT COLOR="#FFFFFF" POINT-SIZE="11">/workshops/{code}/users</FONT></TD></TR></TABLE>>];
legenda [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#111827"><TR><TD BGCOLOR="#FFF9E6">openbaar</TD></TR><TR><TD BGCOLOR="#FECB3D">ingelogd (JWT)</TD></TR><TR><TD BGCOLOR="#8A6408"><FONT COLOR="#FFFFFF">beheerder (ADMIN of SUPER_ADMIN)</FONT></TD></TR></TABLE>>];
{rank=same; "Authenticatie"; "Metingen"; "Meetstations"}
"Authenticatie" -> "Metingen";
"Metingen" -> "Meetstations";
"Authenticatie" -> "Mijn account";
{rank=same; "Mijn account"; "Wijken"; "Snapshot"}
"Mijn account" -> "Wijken";
"Wijken" -> "Snapshot";
"Mijn account" -> "Gebruikers";
{rank=same; "Gebruikers"; "Workshops"; "legenda"}
"Gebruikers" -> "Workshops";
"Workshops" -> "legenda";
