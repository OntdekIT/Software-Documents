node [fontname="Helvetica", fontcolor="#111827", color="#111827", style="filled,rounded", shape=box, fillcolor="#FFF9E6"];
edge [fontname="Helvetica", color="#111827", fontcolor="#4B5563"];
 p [shape=plaintext, style="", label=<<TABLE BORDER="0" CELLSPACING="3"><TR><TD COLSPAN="3" ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="13"><B>Doorlooptijd van gemergede pull requests (backend en frontend samen)</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">tot 15 minuten</FONT></TD><TD BORDER="0"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="300" HEIGHT="14" BGCOLOR="#FECB3D" FIXEDSIZE="TRUE"></TD></TR></TABLE></TD><TD BORDER="0" ALIGN="RIGHT"><FONT POINT-SIZE="11">31</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">15 tot 60 minuten</FONT></TD><TD BORDER="0"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="145" HEIGHT="14" BGCOLOR="#FECB3D" FIXEDSIZE="TRUE"></TD></TR></TABLE></TD><TD BORDER="0" ALIGN="RIGHT"><FONT POINT-SIZE="11">15</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">1 tot 6 uur</FONT></TD><TD BORDER="0"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="194" HEIGHT="14" BGCOLOR="#FECB3D" FIXEDSIZE="TRUE"></TD></TR></TABLE></TD><TD BORDER="0" ALIGN="RIGHT"><FONT POINT-SIZE="11">20</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">6 tot 24 uur</FONT></TD><TD BORDER="0"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="29" HEIGHT="14" BGCOLOR="#FECB3D" FIXEDSIZE="TRUE"></TD></TR></TABLE></TD><TD BORDER="0" ALIGN="RIGHT"><FONT POINT-SIZE="11">3</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">1 tot 7 dagen</FONT></TD><TD BORDER="0"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="10" HEIGHT="14" BGCOLOR="#FECB3D" FIXEDSIZE="TRUE"></TD></TR></TABLE></TD><TD BORDER="0" ALIGN="RIGHT"><FONT POINT-SIZE="11">1</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="11">langer dan 7 dagen</FONT></TD><TD BORDER="0"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="10" HEIGHT="14" BGCOLOR="#FECB3D" FIXEDSIZE="TRUE"></TD></TR></TABLE></TD><TD BORDER="0"