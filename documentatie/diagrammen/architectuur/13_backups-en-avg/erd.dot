digraph erd {
  rankdir=LR; 
  graph [fontname="Helvetica", bgcolor="white", pad="0.3"];
  node [style="filled,rounded", shape=box, fillcolor="#FFF9E6", color="#111827", fontcolor="#111827", fontname="Helvetica", fontsize=11];
  edge [color="#111827", fontcolor="#4B5563", fontname="Helvetica", fontsize=9];

  nodesep=0.4; ranksep=1.0;
  "location" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>location</B> (0 rijen) (geen entiteit)</FONT></TD></TR><TR><TD ALIGN="LEFT">locationid (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE29A">direction</TD><TD ALIGN="LEFT" BGCOLOR="#FBE29A">varchar(255)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE29A">height</TD><TD ALIGN="LEFT" BGCOLOR="#FBE29A">float</TD></TR><TR><TD ALIGN="LEFT">is_outside</TD><TD ALIGN="LEFT">bit(1)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE29A">latitude</TD><TD ALIGN="LEFT" BGCOLOR="#FBE29A">float</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE29A">longitude</TD><TD ALIGN="LEFT" BGCOLOR="#FBE29A">float</TD></TR></TABLE>>];
  "mail" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>mail</B> (0 rijen) (geen entiteit)</FONT></TD></TR><TR><TD ALIGN="LEFT">mail_id (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">body</TD><TD ALIGN="LEFT">varchar(255)</TD></TR><TR><TD ALIGN="LEFT">footer</TD><TD ALIGN="LEFT">varchar(255)</TD></TR><TR><TD ALIGN="LEFT">header</TD><TD ALIGN="LEFT">varchar(255)</TD></TR></TABLE>>];
  "measurement" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>measurement</B> (43643 rijen)</FONT></TD></TR><TR><TD ALIGN="LEFT">humidity</TD><TD ALIGN="LEFT">float</TD></TR><TR><TD ALIGN="LEFT">is_public</TD><TD ALIGN="LEFT">bit(1)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE29A">latitude</TD><TD ALIGN="LEFT" BGCOLOR="#FBE29A">float</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE29A">longitude</TD><TD ALIGN="LEFT" BGCOLOR="#FBE29A">float</TD></TR><TR><TD ALIGN="LEFT">pm25</TD><TD ALIGN="LEFT">float</TD></TR><TR><TD ALIGN="LEFT">temperature</TD><TD ALIGN="LEFT">float</TD></TR><TR><TD ALIGN="LEFT">id (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">stationid</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">timestamp</TD><TD ALIGN="LEFT">datetime(6)</TD></TR><TR><TD ALIGN="LEFT">pm10</TD><TD ALIGN="LEFT">float</TD></TR><TR><TD ALIGN="LEFT">location_inherited</TD><TD ALIGN="LEFT">bit(1)</TD></TR></TABLE>>];
  "region" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>region</B> (59 rijen)</FONT></TD></TR><TR><TD ALIGN="LEFT">id (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(255)</TD></TR></TABLE>>];
  "region_coords" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>region_coords</B> (7951 rijen)</FONT></TD></TR><TR><TD ALIGN="LEFT">latitude</TD><TD ALIGN="LEFT">float</TD></TR><TR><TD ALIGN="LEFT">longitude</TD><TD ALIGN="LEFT">float</TD></TR><TR><TD ALIGN="LEFT">id (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">region_id</TD><TD ALIGN="LEFT">bigint(20)</TD></TR></TABLE>>];
  "sensor" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>sensor</B> (0 rijen) (geen entiteit)</FONT></TD></TR><TR><TD ALIGN="LEFT">sensorid (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">active_data</TD><TD ALIGN="LEFT">bit(1)</TD></TR><TR><TD ALIGN="LEFT">sensor_data</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">sensor_typeid</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">stationid</TD><TD ALIGN="LEFT">bigint(20)</TD></TR></TABLE>>];
  "sensor_type" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>sensor_type</B> (0 rijen) (geen entiteit)</FONT></TD></TR><TR><TD ALIGN="LEFT">typeid (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">type_name</TD><TD ALIGN="LEFT">varchar(255)</TD></TR></TABLE>>];
  "station" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>station</B> (43 rijen)</FONT></TD></TR><TR><TD ALIGN="LEFT">stationid (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FECB3D">name</TD><TD ALIGN="LEFT" BGCOLOR="#FECB3D">varchar(255)</TD></TR><TR><TD ALIGN="LEFT">database_tag</TD><TD ALIGN="LEFT">varchar(255)</TD></TR><TR><TD ALIGN="LEFT">is_public</TD><TD ALIGN="LEFT">bit(1)</TD></TR><TR><TD ALIGN="LEFT">registration_code</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">location_locationid</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">bit(1)</TD></TR><TR><TD ALIGN="LEFT">temp_error</TD><TD ALIGN="LEFT">bit(1)</TD></TR><TR><TD ALIGN="LEFT">hum_error</TD><TD ALIGN="LEFT">bit(1)</TD></TR><TR><TD ALIGN="LEFT">stof_error</TD><TD ALIGN="LEFT">bit(1)</TD></TR><TR><TD ALIGN="LEFT">loc_error</TD><TD ALIGN="LEFT">bit(1)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE29A">last_known_latitude</TD><TD ALIGN="LEFT" BGCOLOR="#FBE29A">float</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE29A">last_known_longitude</TD><TD ALIGN="LEFT" BGCOLOR="#FBE29A">float</TD></TR></TABLE>>];
  "token" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>token</B> (0 rijen)</FONT></TD></TR><TR><TD ALIGN="LEFT">creation_time</TD><TD ALIGN="LEFT">datetime(6)</TD></TR><TR><TD ALIGN="LEFT">id (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3D98B">numeric_code</TD><TD ALIGN="LEFT" BGCOLOR="#F3D98B">varchar(255)</TD></TR><TR><TD ALIGN="LEFT">token_type</TD><TD ALIGN="LEFT">enum('PASSWORD_RESET','VERIFY_AUTH')</TD></TR></TABLE>>];
  "trusted_ip" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>trusted_ip</B> (2 rijen)</FONT></TD></TR><TR><TD ALIGN="LEFT">id (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FBE29A">ip_hash</TD><TD ALIGN="LEFT" BGCOLOR="#FBE29A">varchar(255)</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
  "user" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>user</B> (1 rijen)</FONT></TD></TR><TR><TD ALIGN="LEFT">user_id (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">tinyint(4)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FECB3D">first_name</TD><TD ALIGN="LEFT" BGCOLOR="#FECB3D">varchar(255)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FECB3D">last_name</TD><TD ALIGN="LEFT" BGCOLOR="#FECB3D">varchar(255)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FECB3D">email</TD><TD ALIGN="LEFT" BGCOLOR="#FECB3D">varchar(255)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F3D98B">password</TD><TD ALIGN="LEFT" BGCOLOR="#F3D98B">varchar(255)</TD></TR><TR><TD ALIGN="LEFT">workshop_code</TD><TD ALIGN="LEFT">bigint(20)</TD></TR></TABLE>>];
  "workshop" [shape=plain, style="", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827"><TR><TD COLSPAN="2" BGCOLOR="#111827"><FONT COLOR="white"><B>workshop</B> (2 rijen)</FONT></TD></TR><TR><TD ALIGN="LEFT">code (PK)</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">expiration_date</TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT">creation_date</TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
  "measurement" -> "station" [label="stationid"];
  "region_coords" -> "region" [label="region_id"];
  "sensor" -> "sensor_type" [label="sensor_typeid"];
  "sensor" -> "station" [label="stationid"];
  "station" -> "location" [label="location_locationid"];
  "station" -> "user" [label="user_id"];
  "trusted_ip" -> "user" [label="user_id"];
  "user" -> "workshop" [label="workshop_code"];
  legenda [shape=plain, style="", label=<<TABLE BORDER="0" CELLSPACING="2"><TR><TD BGCOLOR="#FECB3D">persoonsgegeven (naam, e-mail, stationsnaam)</TD></TR><TR><TD BGCOLOR="#FBE29A">locatie of gepseudonimiseerd IP</TD></TR><TR><TD BGCOLOR="#F3D98B">geheim (wachtwoordhash, eenmalige code)</TD></TR></TABLE>>];
}
