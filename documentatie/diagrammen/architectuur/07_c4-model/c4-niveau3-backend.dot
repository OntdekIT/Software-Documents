  "features.user" [label="user\ngebruikers en accounts\n16 klassen", fillcolor="#FFF9E6"];
  "features.user.authentication" [label="user.authentication\ninloggen, tokens, e-mail\n15 klassen", fillcolor="#FFF9E6"];
  "features.user.trustedip" [label="user.trustedip\nvertrouwde IP-adressen\n3 klassen", fillcolor="#FFF9E6"];
  "features.workshop" [label="workshop\nworkshopcodes\n7 klassen", fillcolor="#FFF9E6"];
  "features.e2e" [label="e2e\n(alleen profiel e2e)\n1 klassen", fillcolor="#FFF9E6"];
  "ingest" [label="ingest\nworker, backoff, status\n12 klassen", fillcolor="#FECB3D"];
  "snapshot" [label="snapshot\nvoorberekende staat, /api/snapshot\n7 klassen", fillcolor="#FECB3D"];
  }
  dwars [label="Dwarsverbanden, door bijna alle pakketten gebruikt:\nconfig (13 klassen: beveiliging, JWT, CORS, rate limiting)\nexception (7), utility (16), cache (3)", shape=note, fillcolor="white", style="filled"];
