digraph ERD {
graph [fontname="Helvetica", rankdir=TB, nodesep=0.5, ranksep=0.8, pad=0.3, concentrate=false]
node [shape=none, fontname="Helvetica", fontcolor="#111827"]
edge [color="#111827", fontcolor="#4B5563", fontname="Helvetica", fontsize=10, arrowhead=none, arrowtail=none]
"location" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#E5E7EB" ALIGN="LEFT"><B>location</B> <FONT POINT-SIZE="9" COLOR="#4B5563">(geen entity)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="locationid">locationid</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direction">direction?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="height">height</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_outside">is_outside</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bit(1)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="latitude">latitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="longitude">longitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR></TABLE>>, style=dashed];
"mail" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#E5E7EB" ALIGN="LEFT"><B>mail</B> <FONT POINT-SIZE="9" COLOR="#4B5563">(geen entity)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mail_id">mail_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="body">body?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="footer">footer?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="header">header?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR></TABLE>>, style=dashed];
"measurement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#FECB3D" ALIGN="LEFT"><B>measurement</B></TD></TR><TR><TD ALIGN="LEFT" PORT="humidity">humidity?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_public">is_public?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bit(1)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="latitude">latitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="longitude">longitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pm25">pm25?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="temperature">temperature?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stationid">stationid?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="timestamp">timestamp?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">datetime(6)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pm10">pm10?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="location_inherited">location_inherited</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bit(1)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR></TABLE>>];
"region" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#FECB3D" ALIGN="LEFT"><B>region</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR></TABLE>>];
"region_coords" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#FECB3D" ALIGN="LEFT"><B>region_coords</B></TD></TR><TR><TD ALIGN="LEFT" PORT="latitude">latitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="longitude">longitude</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="region_id">region_id?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>FK</B></FONT></TD></TR></TABLE>>];
"sensor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#E5E7EB" ALIGN="LEFT"><B>sensor</B> <FONT POINT-SIZE="9" COLOR="#4B5563">(geen entity)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sensorid">sensorid</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="active_data">active_data</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bit(1)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sensor_data">sensor_data</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">int(11)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sensor_typeid">sensor_typeid?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stationid">stationid?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>FK</B></FONT></TD></TR></TABLE>>, style=dashed];
"sensor_type" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#E5E7EB" ALIGN="LEFT"><B>sensor_type</B> <FONT POINT-SIZE="9" COLOR="#4B5563">(geen entity)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="typeid">typeid</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="type_name">type_name?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR></TABLE>>, style=dashed];
"station" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#FECB3D" ALIGN="LEFT"><B>station</B></TD></TR><TR><TD ALIGN="LEFT" PORT="stationid">stationid</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="database_tag">database_tag?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_public">is_public</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bit(1)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="registration_code">registration_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="location_locationid">location_locationid?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bit(1)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="temp_error">temp_error</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bit(1)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hum_error">hum_error</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bit(1)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stof_error">stof_error</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bit(1)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="loc_error">loc_error</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bit(1)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_known_latitude">last_known_latitude?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_known_longitude">last_known_longitude?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">float</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR></TABLE>>];
"token" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#FECB3D" ALIGN="LEFT"><B>token</B></TD></TR><TR><TD ALIGN="LEFT" PORT="creation_time">creation_time?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">datetime(6)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numeric_code">numeric_code?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="token_type">token_type?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">enum('PASSWORD_RESET','VERIFY_AUTH')</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR></TABLE>>];
"trusted_ip" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#FECB3D" ALIGN="LEFT"><B>trusted_ip</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ip_hash">ip_hash</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">datetime</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR></TABLE>>];
"user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#FECB3D" ALIGN="LEFT"><B>user</B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">tinyint(4)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name">first_name?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name">last_name?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>UQ</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password">password?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">varchar(255)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="workshop_code">workshop_code?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>FK</B></FONT></TD></TR></TABLE>>];
"workshop" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#111827" BGCOLOR="#FFF9E6"><TR><TD COLSPAN="3" BGCOLOR="#FECB3D" ALIGN="LEFT"><B>workshop</B></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">bigint(20)</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expiration_date">expiration_date?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">datetime</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creation_date">creation_date?</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4B5563">datetime</FONT></TD><TD><FONT POINT-SIZE="9" COLOR="#8A6408">&nbsp;</FONT></TD></TR></TABLE>>];
"station" -> "measurement" [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="*", label="stationid (optioneel)"];
"region" -> "region_coords" [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="*", label="region_id (optioneel)"];
"sensor_type" -> "sensor" [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="*", label="sensor_typeid (optioneel)"];
"station" -> "sensor" [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="*", label="stationid (optioneel)"];
"location" -> "station" [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="*", label="location_locationid (optioneel)"];
"user" -> "station" [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="*", label="user_id (optioneel)"];
"user" -> "trusted_ip" [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="*", label="user_id"];
"workshop" -> "user" [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="*", label="workshop_code (optioneel)"];
"user" -> "token" [style=dashed, dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="*", label="user_id (geen FK in DB)"];
}